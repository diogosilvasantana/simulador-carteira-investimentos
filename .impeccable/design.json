  "components": [
    {
      "name": "Botão primário",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação principal da tela; índigo cheio, um por grupo de ações.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Simular</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 16px;border-radius:var(--radius-sm);border:1px solid var(--control-border);background:transparent;color:var(--text);font-family:var(--font-sans);font-size:14px;font-weight:600;cursor:pointer;transition:background var(--duration-quick) var(--ease-out),border-color var(--duration-quick) var(--ease-out)} .ds-btn-primary{background:var(--accent-strong);border-color:var(--accent-strong);color:var(--on-accent)} .ds-btn-primary:hover{background:#4b4ce0} .ds-btn:focus-visible{outline:none;box-shadow:var(--focus-ring)} .ds-btn:disabled{opacity:.45;cursor:default}"
    },
    {
      "name": "Botão secundário",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Ação alternativa; contorno em borda de controle.",
      "html": "<button class=\"ds-btn-secondary\">Simular renda fixa</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;min-height:40px;padding:0 16px;border-radius:var(--radius-sm);border:1px solid var(--control-border);background:transparent;color:var(--text);font-family:var(--font-sans);font-size:14px;font-weight:600;cursor:pointer;transition:background var(--duration-quick) var(--ease-out)} .ds-btn-secondary:hover{background:var(--surface-2)} .ds-btn-secondary:focus-visible{outline:none;box-shadow:var(--focus-ring)}"
    },
    {
      "name": "Campo de formulário",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Rótulo acima, campo em carvão 2; borda rosa quando inválido.",
      "html": "<label class=\"ds-field\">Valor aplicado (R$)<input value=\"10.000,00\" inputmode=\"decimal\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font-family:var(--font-sans);font-size:12px;font-weight:500;color:var(--text-muted)} .ds-field input{min-height:40px;padding:0 12px;background:var(--surface-2);border:1px solid var(--control-border);border-radius:var(--radius-sm);color:var(--text);font:inherit;font-size:14px;font-weight:400;font-variant-numeric:tabular-nums} .ds-field input:focus-visible{outline:none;border-color:var(--accent);box-shadow:var(--focus-ring)} .ds-field input[aria-invalid=true]{border-color:var(--loss)}"
    },
    {
      "name": "Busca",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Busca em pílula com lupa de traço; foco tinge a borda de índigo.",
      "html": "<label class=\"ds-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zm9 16-4.3-4.3\"/></svg><input type=\"search\" placeholder=\"Ticker ou nome\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;min-width:240px;height:36px;padding:0 12px;background:var(--surface-1);border:1px solid var(--control-border);border-radius:var(--radius-pill);color:var(--text-subtle);font-family:var(--font-sans);font-size:14px} .ds-search:focus-within{border-color:var(--accent)} .ds-search input{flex:1;min-width:0;border:0;background:transparent;outline:none;color:var(--text);font:inherit} .ds-search input::placeholder{color:var(--text-subtle)}"
    },
    {
      "name": "Menu lateral",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Itens de 40 px com ícone de traço; ativo em índigo profundo. Recolhe para 64 px e vira barra inferior no celular.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z\"/></svg>Início</a><a class=\"ds-nav-item ds-nav-item-active\" href=\"#\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 19V9m6 10V5m6 14v-8m6 8H2\"/></svg>Cotações</a><a class=\"ds-nav-item\" href=\"#\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 9 12 4l9 5M5 10v8m4.5-8v8m5-8v8M19 10v8M3 20h18\"/></svg>Renda fixa</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:4px;width:232px;padding:16px 12px;background:var(--surface-1);border-right:1px solid var(--line);font-family:var(--font-sans);font-size:14px} .ds-nav-item{display:flex;align-items:center;gap:12px;min-height:40px;padding:0 12px;border-radius:var(--radius-sm);color:var(--text-muted);font-weight:500;text-decoration:none;transition:background var(--duration-quick) var(--ease-out),color var(--duration-quick) var(--ease-out)} .ds-nav-item:hover{background:var(--surface-2);color:var(--text)} .ds-nav-item-active,.ds-nav-item-active:hover{background:var(--accent-soft);color:var(--accent)} .ds-nav-item:focus-visible{outline:none;box-shadow:var(--focus-ring)}"
    },
    {
      "name": "Selo SIMULADO",
      "kind": "chip",
      "refersTo": "sim-seal",
      "description": "Pílula âmbar fixa no canto direito da faixa superior de toda tela.",
      "html": "<span class=\"ds-sim\" title=\"Nenhuma ordem chega à B3\">SIMULADO</span>",
      "css": ".ds-sim{display:inline-flex;align-items:center;height:24px;padding:0 12px;border-radius:var(--radius-pill);background:var(--warning-soft);color:var(--warning);font-family:var(--font-sans);font-size:11px;font-weight:700;letter-spacing:.06em}"
    },
    {
      "name": "Status de conexão",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "Pílula com ponto de estado; só em Cotações, à esquerda da faixa superior.",
      "html": "<span class=\"ds-status ds-status-connected\">Ao vivo</span> <span class=\"ds-status ds-status-connecting\">Conectando às cotações…</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:8px;height:28px;padding:0 12px;border-radius:var(--radius-pill);border:1px solid var(--line);font-family:var(--font-sans);font-size:12px;font-weight:500;color:var(--text-muted);white-space:nowrap} .ds-status::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--text-subtle)} .ds-status-connected::before{background:var(--gain)} .ds-status-connecting::before{background:var(--warning)}"
    },
    {
      "name": "Variação com seta",
      "kind": "chip",
      "refersTo": "change-up",
      "description": "Alta e baixa com seta desenhada em CSS, sinal e texto para leitor de tela.",
      "html": "<span class=\"ds-change ds-change-up\"><span class=\"ds-arrow\" aria-hidden=\"true\"></span>+1,79%</span> <span class=\"ds-change ds-change-down\"><span class=\"ds-arrow\" aria-hidden=\"true\"></span>-1,98%</span>",
      "css": ".ds-change{display:inline-flex;align-items:center;gap:4px;padding:1px 6px;border-radius:var(--radius-xs);font-family:var(--font-sans);font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--text-muted)} .ds-change-up{color:var(--gain);background:var(--gain-soft)} .ds-change-down{color:var(--loss);background:var(--loss-soft)} .ds-arrow{width:8px;height:5px;background:currentColor} .ds-change-up .ds-arrow{clip-path:polygon(50% 0,100% 100%,0 100%)} .ds-change-down .ds-arrow{clip-path:polygon(0 0,100% 0,50% 100%)}"
